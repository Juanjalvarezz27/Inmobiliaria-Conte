generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  EMPLEADO
  INQUILINO
}

enum TipoPropiedad {
  CENTRO_COMERCIAL // Complejos con locales o kioskos
  EDIFICIO         // Edificios residenciales o corporativos con apartamentos u oficinas
  CASA             // Casas o quintas independientes
  APARTAMENTO      // Apartamento independiente
  LOCAL            // Local comercial independiente a pie de calle
  TERRENO          // Terreno o lote
  GALPON           // Galpón o nave industrial
  OTRO
}

enum TipoUnidad {
  LOCAL
  APARTAMENTO
  OFICINA
  DEPOSITO
  CASA
  OTRO
}

enum EstadoUnidad {
  DISPONIBLE
  OCUPADO
  MANTENIMIENTO
  INACTIVO
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  apellido     String?
  cedula       String?  @unique
  telefono     String?
  direccion    String?
  ubicacion    String?  // Coordenadas o zona (para tracking de empleados)
  rol          Rol      @default(INQUILINO)
  activo       Boolean  @default(true)

  inquilino    Inquilino?
  empleado     Empleado?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("usuarios")
}

model Propiedad {
  id              String        @id @default(cuid())
  nombre          String
  tipo            TipoPropiedad @default(CENTRO_COMERCIAL)
  direccion       String
  ciudad          String
  descripcion     String?
  numPisos        Int?          // Número de pisos (para Edificio, Centro Comercial, etc.)
  areaTotalM2     Float?        // Área total de construcción o terreno en m²
  propietario      String?       // Propietario o empresa dueña (opcional: si es nulo es de la inmobiliaria/Fabián)
  telefonoContacto String?       // Teléfono de contacto o administración del inmueble
  activo          Boolean       @default(true)

  unidades                 Unidad[]
  transaccionesFinancieras TransaccionFinanciera[]
  tareasEmpleados          TareaEmpleado[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("propiedades")
}

model Unidad {
  id             String       @id @default(cuid())
  codigo         String       // Ej: "Local 12-B", "Apto 4A", "Principal"
  tipo           TipoUnidad   @default(LOCAL)
  piso           String?      // Ej: "Planta Baja", "Piso 4"
  areaMt2        Float?       // Área en m²
  precioAlquiler Float?       // Canon de arrendamiento mensual
  descripcion    String?
  estado         EstadoUnidad @default(DISPONIBLE)
  imagenes       String[]     // Fotos de la unidad

  propiedadId    String
  propiedad      Propiedad    @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  contratos                Contrato[]
  transaccionesFinancieras TransaccionFinanciera[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("unidades")
}

enum TipoPersona {
  NATURAL
  JURIDICA
}

enum EstadoContrato {
  ACTIVO
  POR_VENCER
  FINALIZADO
  RESCINDIDO
}

model Inquilino {
  id                 String       @id @default(cuid())
  nombre             String       // Nombre o Razón Social
  apellido           String?      // Apellido si es persona natural
  tipoPersona        TipoPersona  @default(NATURAL)
  documentoIdentidad String       @unique // Cédula o RIF único (ej: V-12345678, J-12345678-9)
  telefono           String       // Teléfono principal con WhatsApp
  telefonoSecundario String?      // Teléfono secundario o de oficina
  email              String?      // Correo para recibos y notificaciones
  direccion          String?      // Dirección fiscal o de habitación
  activo             Boolean      @default(true)

  usuarioId          String?      @unique
  usuario            Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  contratos          Contrato[]

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("inquilinos")
}

model Contrato {
  id               String         @id @default(cuid())
  codigo           String         @unique // Código visible de contrato, ej: "CTR-2026-001"
  inquilinoId      String
  inquilino        Inquilino      @relation(fields: [inquilinoId], references: [id], onDelete: Restrict)
  unidadId         String
  unidad           Unidad         @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  fechaInicio                       DateTime
  fechaFin                          DateTime
  diaCobro                          Int            @default(1) // Día de corte de pago mensual (1-31)
  montoAlquiler                     Float          // Canon de arrendamiento mensual acordado
  depositoGarantia                  Float?         // Monto del depósito en garantía
  depositoEstado                    EstadoDeposito @default(NO_APLICA)
  depositoFechaCobro                DateTime?      // Fecha en que se cobró el depósito
  depositoMetodoPago                MetodoPago?    // Método con el que se cobró
  depositoReferencia                String?        // Referencia bancaria o número de recibo de cobro
  depositoComprobanteUrl            String?        // Comprobante digital de cobro
  depositoNotas                     String?        // Observaciones al momento de cobrar
  
  // Liquidación del depósito (al finalizar o rescindir el contrato)
  depositoFechaLiquidacion          DateTime?      // Fecha en que se liquidó
  depositoMontoReembolsado          Float?         // Monto devuelto al inquilino
  depositoMontoRetenido             Float?         // Monto retenido por daños o deudas
  depositoMetodoPagoLiquidacion     MetodoPago?    // Método de pago usado para devolver el depósito
  depositoReferenciaLiquidacion     String?        // Referencia bancaria del reembolso
  depositoMotivoLiquidacion         String?        // Motivo de retención o deducción
  depositoComprobanteLiquidacionUrl String?        // Comprobante de la devolución o facturas de reparaciones
  moneda                            String         @default("USD")

  estado                            EstadoContrato @default(ACTIVO)
  documentoUrl                      String?        // Enlace al contrato PDF firmado en UploadThing
  notas                             String?        // Observaciones o cláusulas especiales

  pagos                             Pago[]

  createdAt                         DateTime       @default(now())
  updatedAt                         DateTime       @updatedAt

  @@map("contratos")
}

enum EstadoDeposito {
  NO_APLICA
  PENDIENTE
  COBRADO
  REEMBOLSADO
  RETENIDO
  PARCIALMENTE_RETENIDO
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  VENCIDO
  PARCIAL
}

enum MetodoPago {
  EFECTIVO_USD
  TRANSFERENCIA
  PAGO_MOVIL
  ZELLE
  OTRO
}

model Pago {
  id               String      @id @default(cuid())
  contratoId       String
  contrato         Contrato    @relation(fields: [contratoId], references: [id], onDelete: Restrict)
  periodoMes       Int         // 1 - 12
  periodoAno       Int         // Ej: 2026
  montoEsperado    Float
  montoPagado      Float       @default(0)
  fechaVencimiento DateTime
  fechaPago        DateTime?
  metodoPago       MetodoPago?
  referencia       String?
  comprobanteUrl   String?
  estado           EstadoPago  @default(PENDIENTE)
  notas            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  transacciones    TransaccionPago[]

  @@unique([contratoId, periodoMes, periodoAno])
  @@index([periodoAno, periodoMes])
  @@map("pagos")
}

model TransaccionPago {
  id             String      @id @default(cuid())
  pagoId         String
  pago           Pago        @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  monto          Float       // Monto de este abono específico en USD
  fechaPago      DateTime    @default(now()) // Fecha en que se recibió el abono
  metodoPago     MetodoPago  // Efectivo, Zelle, Transferencia, etc.
  referencia     String?     // Número de referencia bancaria o recibo
  comprobanteUrl String?     // URL de la captura o voucher de este abono
  notas          String?     // Observaciones del abono
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("transacciones_pago")
}

enum TipoTransaccionFinanciera {
  EGRESO
  INGRESO
}

enum CategoriaTransaccion {
  SERVICIOS_PUBLICOS     // Electricidad, agua, aseo, gas, internet
  MANTENIMIENTO_LIMPIEZA // Condominio, limpieza, áreas comunes, jardinería
  REPARACIONES           // Plomería, electricidad, bombas, albañilería
  NOMINA_PERSONAL        // Conserjería, vigilancia, honorarios
  SUMINISTROS_OFICINA    // Artículos de oficina, bombillos, ferretería
  IMPUESTOS_TASAS        // Tasas municipales, alcaldía, patentes
  LEGAL_ADMINISTRATIVO   // Gastos legales, notarías, registros
  PUBLICIDAD_MARKETING   // Redes, avisos, pendones
  ALQUILER_COBRANZA      // Canon de arrendamiento devengado
  ESTACIONAMIENTO        // Puestos de parking
  EVENTO_FERIA           // Alquiler temporal de plazoletas
  OTRO                   // Gastos o ingresos imprevistos
}

model TransaccionFinanciera {
  id             String                    @id @default(cuid())
  tipo           TipoTransaccionFinanciera @default(EGRESO)
  categoria      CategoriaTransaccion      @default(OTRO)
  concepto       String                    // Ej: "Pago Corpoelec Octubre - CC Las Américas"
  monto          Float                     // En USD
  fecha          DateTime                  @default(now())
  periodoMes     Int                       // 1 - 12
  periodoAno     Int                       // Ej: 2026
  metodoPago     MetodoPago                @default(EFECTIVO_USD)
  referencia     String?                   // Nro de factura o transferencia
  beneficiario   String?                   // Proveedor o emisor (Ej: "Corpoelec", "Hidrosuroeste")
  comprobanteUrl String?                   // Factura o recibo en UploadThing
  notas          String?

  propiedadId    String?
  propiedad      Propiedad?                @relation(fields: [propiedadId], references: [id], onDelete: SetNull)

  unidadId       String?
  unidad         Unidad?                   @relation(fields: [unidadId], references: [id], onDelete: SetNull)

  activo         Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([periodoAno, periodoMes])
  @@index([tipo])
  @@index([categoria])
  @@index([propiedadId])
  @@map("transacciones_financieras")
}

enum CargoEmpleado {
  CONSERJE
  TECNICO_MANTENIMIENTO
  ELECTRICISTA
  PLOMERO
  SEGURIDAD
  SUPERVISOR
  ADMINISTRATIVO
  OTRO
}

enum EstadoAsistencia {
  PRESENTE
  RETARDO
  FALTA_JUSTIFICADA
  FALTA_INJUSTIFICADA
  PERMISO
}

enum PrioridadTarea {
  BAJA
  NORMAL
  ALTA
  URGENTE
}

enum EstadoTarea {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

model Empleado {
  id             String               @id @default(cuid())
  nombre         String
  apellido       String?
  cedula         String               @unique
  telefono       String
  email          String?
  direccion      String?
  cargo          CargoEmpleado        @default(CONSERJE)
  fechaIngreso   DateTime             @default(now())
  salarioMensual Float?               // Salario u honorarios en USD
  activo         Boolean              @default(true)
  notas          String?

  usuarioId      String?              @unique
  usuario        Usuario?             @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  asistencias    RegistroAsistencia[]
  tareas         TareaEmpleado[]

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("empleados")
}

model RegistroAsistencia {
  id               String           @id @default(cuid())
  empleadoId       String
  empleado         Empleado         @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  fecha            DateTime         @default(now()) // Día de la jornada
  horaEntrada      DateTime         @default(now())
  horaSalida       DateTime?
  estado           EstadoAsistencia @default(PRESENTE)
  ubicacionEntrada String?          // Inmueble o referencia de entrada
  ubicacionSalida  String?          // Inmueble o referencia de salida
  observaciones    String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([empleadoId, fecha])
  @@map("registros_asistencia")
}

model TareaEmpleado {
  id              String         @id @default(cuid())
  titulo          String
  descripcion     String?
  empleadoId      String
  empleado        Empleado       @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  propiedadId     String?
  propiedad       Propiedad?     @relation(fields: [propiedadId], references: [id], onDelete: SetNull)
  prioridad       PrioridadTarea @default(NORMAL)
  estado          EstadoTarea    @default(PENDIENTE)
  fechaLimite     DateTime?
  fechaCompletada DateTime?
  evidencias      String[]       // URLs de imágenes en UploadThing
  notasResolucion String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([empleadoId, estado])
  @@index([propiedadId])
  @@map("tareas_empleados")
}

