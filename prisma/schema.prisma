generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  EMPLEADO
  INQUILINO
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  apellido     String?
  cedula       String?  @unique
  telefono     String?
  direccion    String?
  ubicacion    String?  // Coordenadas o zona (para tracking de empleados)
  rol          Rol      @default(INQUILINO)
  activo       Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("usuarios")
}
