generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  EMPLEADO
  INQUILINO
}

enum TipoPropiedad {
  CENTRO_COMERCIAL // Complejos con locales o kioskos
  EDIFICIO         // Edificios residenciales o corporativos con apartamentos u oficinas
  CASA             // Casas o quintas independientes
  APARTAMENTO      // Apartamento independiente
  LOCAL            // Local comercial independiente a pie de calle
  TERRENO          // Terreno o lote
  GALPON           // Galpón o nave industrial
  OTRO
}

enum TipoUnidad {
  LOCAL
  APARTAMENTO
  OFICINA
  DEPOSITO
  CASA
  OTRO
}

enum EstadoUnidad {
  DISPONIBLE
  OCUPADO
  MANTENIMIENTO
  INACTIVO
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  apellido     String?
  cedula       String?  @unique
  telefono     String?
  direccion    String?
  ubicacion    String?  // Coordenadas o zona (para tracking de empleados)
  rol          Rol      @default(INQUILINO)
  activo       Boolean  @default(true)

  inquilino    Inquilino?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("usuarios")
}

model Propiedad {
  id              String        @id @default(cuid())
  nombre          String
  tipo            TipoPropiedad @default(CENTRO_COMERCIAL)
  direccion       String
  ciudad          String
  descripcion     String?
  numPisos        Int?          // Número de pisos (para Edificio, Centro Comercial, etc.)
  areaTotalM2     Float?        // Área total de construcción o terreno en m²
  propietario      String?       // Propietario o empresa dueña (opcional: si es nulo es de la inmobiliaria/Fabián)
  telefonoContacto String?       // Teléfono de contacto o administración del inmueble

  unidades    Unidad[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("propiedades")
}

model Unidad {
  id             String       @id @default(cuid())
  codigo         String       // Ej: "Local 12-B", "Apto 4A", "Principal"
  tipo           TipoUnidad   @default(LOCAL)
  piso           String?      // Ej: "Planta Baja", "Piso 4"
  areaMt2        Float?       // Área en m²
  precioAlquiler Float?       // Canon de arrendamiento mensual
  descripcion    String?
  estado         EstadoUnidad @default(DISPONIBLE)
  imagenes       String[]     // Fotos de la unidad

  propiedadId    String
  propiedad      Propiedad    @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  contratos      Contrato[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("unidades")
}

enum TipoPersona {
  NATURAL
  JURIDICA
}

enum EstadoContrato {
  ACTIVO
  POR_VENCER
  FINALIZADO
  RESCINDIDO
}

model Inquilino {
  id                 String       @id @default(cuid())
  nombre             String       // Nombre o Razón Social
  apellido           String?      // Apellido si es persona natural
  tipoPersona        TipoPersona  @default(NATURAL)
  documentoIdentidad String       @unique // Cédula o RIF único (ej: V-12345678, J-12345678-9)
  telefono           String       // Teléfono principal con WhatsApp
  telefonoSecundario String?      // Teléfono secundario o de oficina
  email              String?      // Correo para recibos y notificaciones
  direccion          String?      // Dirección fiscal o de habitación
  activo             Boolean      @default(true)

  usuarioId          String?      @unique
  usuario            Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  contratos          Contrato[]

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("inquilinos")
}

model Contrato {
  id               String         @id @default(cuid())
  codigo           String         @unique // Código visible de contrato, ej: "CTR-2026-001"
  inquilinoId      String
  inquilino        Inquilino      @relation(fields: [inquilinoId], references: [id], onDelete: Restrict)
  unidadId         String
  unidad           Unidad         @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  fechaInicio      DateTime
  fechaFin         DateTime
  diaCobro         Int            @default(1) // Día de corte de pago mensual (1-31)
  montoAlquiler    Float          // Canon de arrendamiento mensual acordado
  depositoGarantia Float?         // Monto del depósito en garantía
  moneda           String         @default("USD")

  estado           EstadoContrato @default(ACTIVO)
  documentoUrl     String?        // Enlace al contrato PDF firmado en UploadThing
  notas            String?        // Observaciones o cláusulas especiales

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("contratos")
}


