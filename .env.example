# Base de datos (Neon / PostgreSQL)
# Para Neon: Usar conexión directa (sin pgbouncer/pooling)
DATABASE_URL="postgresql://usuario:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Autenticación (Auth.js v5)
# Generar clave secreta con: openssl rand -base64 32
AUTH_SECRET="tu-auth-secret-seguro-aqui"
AUTH_URL="http://localhost:3000"

# Almacenamiento CDN para PDFs e Imágenes (UploadThing)
# Obtener en https://uploadthing.com/dashboard
UPLOADTHING_TOKEN="tu-uploadthing-token-aqui"

# Correos transaccionales (Gmail SMTP)
# Para EMAIL_PASS: Cuenta de Google -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones
EMAIL_USER="tu-empresa@gmail.com"
EMAIL_PASS="abcd efgh ijkl mnop"
EMAIL_FROM_NAME="Inmobiliaria Conté"

# Correo donde el dueño recibirá alertas automáticas (vencimientos, reportes, pagos)
ADMIN_NOTIFICATION_EMAIL="correo-personal-dueno@gmail.com"
